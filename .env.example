# PostgreSQL Database Connection URL (e.g. Neon PostgreSQL, Supabase, or Local PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/studytrack?schema=public"

# NextAuth / Auth.js Configuration
# Secret key for signing session tokens and encryption. Generate via: openssl rand -base64 32
NEXTAUTH_SECRET="studytrack_super_secret_jwt_key_at_least_32_chars_long_12345"

# Canonical URL of the application in development or production
# Development: http://localhost:3000
# Production: https://your-studytrack-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
